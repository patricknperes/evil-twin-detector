{
  "name": "evil-twin-detector-desktop",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force --pretty false",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/backend-manager.cjs && node --check electron/auto-scan-scheduler.cjs",
    "build:web": "tsc -b && vite build",
    "dist:win": "electron-builder --win nsis",
    "dist:win:dir": "electron-builder --win dir",
    "scheduler:check": "node tests/auto_scan_scheduler_step40.cjs",
    "validate": "npm test && npm run typecheck && npm run build:web",
    "integration:check": "node tests/desktop_integration_step48.cjs",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:headed": "playwright test -c playwright.config.ts --headed"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "30.0.1",
    "playwright": "^1.49.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.2.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "br.edu.ufop.eviltwindetector",
    "productName": "Evil Twin Detector",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend/evil-twin-backend.exe",
        "to": "backend/evil-twin-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "executableName": "EvilTwinDetector",
      "icon": "resources/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Evil Twin Detector",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "resources/build/icon.ico",
      "uninstallerIcon": "resources/build/icon.ico"
    }
  }
}
