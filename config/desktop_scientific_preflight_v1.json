    "multi_environment_own_data": "separate cohort/protocol, not silent merge into E6 freeze"
  },
  "candidate_reference_coverage_gate": {
    "enabled": true,
    "minimum_eligible_rate_each_split": 0.7,
    "splits": [
      "model_train",
      "validation",
      "test_normal"
    ],
    "runs_before_freeze": true
  }
