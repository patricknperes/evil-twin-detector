  },
  "temporal_overlap": {
    "policy": "warning"
  },
  "split": {
    "unit": "session_id",
    "seed": 20260831,
    "minimum_allocation": {
      "reference": 1,
      "model_train": 2,
      "validation": 1,
      "test_normal": 1
    },
    "row_level_random_split": false,
    "immutable_after_ready": true,
    "blocked_plan_can_regenerate": true,
    "new_sessions_after_freeze": "reported_but_unassigned"
  },
  "freeze_artifacts": [
    "session_split_plan.json",
    "scientific_freeze.json",
    "desktop_normal_reference.json",
    "preparation_manifest.json"
  ],
  "downstream_ml_gate": "verify_prepared_freeze_integrity",
  "normal_cohort": {
