{
  "schema_version": "desktop_scientific_preflight_v1",
  "phase": 4,
  "step": 52,
  "dataset": "own_windows",
  "purpose": "Integrity gate before desktop_candidate_v1 split/reference freeze",
  "minimum_valid_sessions": 5,
  "required_session_semantics": {
    "source_dataset": "own_windows",
    "label": 0,
