        },
        {
          "feature": "bssid_changed",
          "origin": "mudança de BSSID observada para o mesmo SSID ao longo do tempo",
          "desktop_candidate": true,
          "risk": "Precisa de histórico e comparação contextual."
        },
        {
          "feature": "channel_changed",
          "origin": "mudança temporal de canal do mesmo identificador/rede",
          "desktop_candidate": true,
          "risk": "Mudanças legítimas existem; não é prova isolada de ataque."
        },
        {
          "feature": "security_changed",
          "origin": "mudança temporal de security_type para a mesma identidade lógica",
          "desktop_candidate": true,
          "risk": "Exige baseline histórico da rede."
        },
        {
          "feature": "security_strength_delta",
          "origin": "comparação ordinal de segurança dentro do contexto da rede",
          "desktop_candidate": true,
          "risk": "A codificação ordinal precisa ser explícita e não usada como identidade."
        },
        {
          "feature": "bssid_local_admin_flag",
          "origin": "bit U/L do primeiro octeto do BSSID",
          "desktop_candidate": true,
          "risk": "Pode detectar a construção synthetic local_admin_bssid de forma muito direta. Deve ser avaliada separadamente para não confundir regra específica com generalização."
        },
        {
          "feature": "tsf_monotonic_violation",
          "origin": "BeaconTimestamp/TSF temporal",
          "desktop_candidate": false,
          "risk": "Disponibilidade no scanner Windows ainda não foi validada; usar apenas no experimento acadêmico se observável."
        },
        {
          "feature": "observed_channel_vs_advertised_mismatch",
          "origin": "Channel vs DSChannel/advertised channel",
          "desktop_candidate": "pending_scanner_validation",
          "risk": "Semântica depende do método de captura."
        },
        {
          "feature": "configured_beacon_interval_ms",
          "origin": "BeaconInterval configurado",
          "desktop_candidate": "pending_scanner_validation",
          "risk": "No Mendeley normal é quase constante; isoladamente tem pouco valor."
        },
        {
          "feature": "is_hidden",
          "origin": "estado de SSID oculto",
          "desktop_candidate": true,
          "risk": "Rede oculta pode ser legítima; usar apenas como contexto."
